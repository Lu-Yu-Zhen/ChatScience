{
  "name": "chatscience-desktop",
  "version": "1.0.0",
  "description": "ChatScience 桌面便携版（Electron 前后端分离）",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webapp.json --noEmit && tsc -p tsconfig.verify.json --noEmit",
    "build:ts": "tsc && tsc -p tsconfig.webapp.json && tsc -p tsconfig.verify.json",
    "verify": "node verify/verify-suite.js",
    "wiki:lint": "node tools/wiki-lint.js",
    "guard:artifacts": "npm run build:ts && git -C .. diff --exit-code --name-only -- webapp \":(glob)app/**/*.js\" app/renderer/index.html",
    "start": "npm run build:ts && electron ."
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2",
    "typescript": "^5.9.2",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@qodercn-ai/qodercn-agent-sdk": "^1.0.34",
    "express": "^4.19.2",
    "zod": "^4.0.0"
  }
}
