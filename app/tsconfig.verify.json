{
  /* ChatScience 验证与工具脚本编译配置（verify 层）
     - 覆盖：verify/*.ts（验证脚本，产物落回 verify/*.js）、
       server/skills-plugin/build.ts（技能包生成器）。
     - 验证脚本是行为安全网，按宽松配置编译（允许隐式 any，require 返回 any），
       与迁移前 JS 版语义逐行一致；noEmitOnError 仍然生效。 */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/verify/**/*.ts",
    "src/server/skills-plugin/build.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
